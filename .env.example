# Copy the keys you need into the root .env (Laravel only loads that file).
# true enables the bot/relay
DISCORD_ENABLED=false
# bot token
DISCORD_TOKEN=
# webhook url for posts
DISCORD_WEBHOOK_URL=
# guild (server) id
DISCORD_GUILD=
# true connects to the Discord gateway
DISCORD_GATEWAY=false
# line-JSON command server for outside processes (needs a secret)
DISCORD_COMMAND_SERVER=false
DISCORD_COMMAND_HOST=127.0.0.1
DISCORD_COMMAND_PORT=9999
DISCORD_COMMAND_SECRET=
# channel id for the game relay
DISCORD_RELAY_CHANNEL=
# relay in-game chat
DISCORD_RELAY_CHAT=false
# relay player join/leave
DISCORD_RELAY_JOIN_LEAVE=false
# relay new map announcements
DISCORD_RELAY_NEW_MAP=false
# comma-separated roles allowed admin commands
DISCORD_ADMIN_ROLES=Admin,Owner
# channel id for track suggestions (unset = built-in default)
# DISCORD_SUGGEST_CHANNEL=
